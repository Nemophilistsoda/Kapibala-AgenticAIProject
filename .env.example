# 复制本文件为 .env，填入真实值。.env 已被 .gitignore 排除，不要提交。
#
# ⛔ 本次笔试要求 repo 设置为 PUBLIC。真实 key 一旦进入任何一个 commit，
#    即使之后删除文件也会永久留在 git 历史里，只能靠 rotate key 补救。

# kGroup / KapibalaAI 提供的 Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# 实际可用的模型名以 kGroup 的凭证文档为准，不要硬编码进源码
GEMINI_MODEL=gemini-2.5-flash

# ---- 以下为可选，留空则用代码里的默认值 ----

# 速率限制窗口（秒）。题目硬性要求 60，改动仅用于测试
RATE_LIMIT_WINDOW_SECONDS=60

# 连续 anomaly 多少次后强制转人工。题目硬性要求 2
ANOMALY_ESCALATION_THRESHOLD=2

# 会话状态数据库路径
AGENT_DB_PATH=agent.db

# 审计日志路径
AUDIT_LOG_PATH=audit.jsonl
